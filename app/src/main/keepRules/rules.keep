# WebRTC / jni_zero classes are referenced from native code through
# JNI_OnLoad, so R8 cannot discover every use statically.
-keep class org.jni_zero.** { *; }
-keep class org.webrtc.** { *; }

# Preserve JNI entry points selected through annotations or native methods.
-keepclasseswithmembers class * {
    @org.jni_zero.* <methods>;
}
-keepclasseswithmembernames class * {
    native <methods>;
}
